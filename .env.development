# 开发环境共享配置（提交到 git，不要放敏感信息）
# 敏感信息请放到 .env.development.local 中（已被 gitignore）
NODE_ENV=development

# 后端
PORT=3001

# 对应 compose.yaml 的本地 MySQL；自定义配置放到 .env 或 .env.development.local
DATABASE_URL="mysql://propet:propet_dev_password@127.0.0.1:3306/propet"
SHADOW_DATABASE_URL="mysql://propet:propet_dev_password@127.0.0.1:3306/propet_shadow"

JWT_SECRET=change-me-in-local
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# 前端
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Propet Dev
