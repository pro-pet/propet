# ===========================================
# Propet Monorepo 环境变量
# ===========================================
# 复制此文件到 .env；现有 .env.*.local 的优先级更高，请同步更新数据库地址

# 通用
NODE_ENV=development

# 后端配置 (NestJS)
PORT=3001
DATABASE_URL=mysql://propet:propet_dev_password@127.0.0.1:3306/propet
SHADOW_DATABASE_URL=mysql://propet:propet_dev_password@127.0.0.1:3306/propet_shadow
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# 前端配置 (Next.js)
# NEXT_PUBLIC_ 前缀的变量会暴露给客户端
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Propet

# Docker Compose（仅用于本地开发，数据库名/用户固定为 propet）
# 如修改密码或端口，请同步更新上面的数据库 URL。
# MYSQL_PASSWORD 使用 URL 安全字符（如字母、数字、下划线），供容器连接 URL 使用。
MYSQL_PASSWORD=propet_dev_password
MYSQL_ROOT_PASSWORD=propet_root_dev_password
MYSQL_PORT=3306
SERVICE_PORT=3001
WEB_PORT=3000

# Next.js 服务端访问后端的地址；Compose 自动设置为 http://service:3001
# API_URL=http://localhost:3001
